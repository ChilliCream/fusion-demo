{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wave pipeline implementer or fixer result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "commits",
    "verified",
    "notVerified",
    "escalation"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed"]
    },
    "commits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notVerified": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "escalation": {
      "type": ["string", "null"]
    }
  }
}
